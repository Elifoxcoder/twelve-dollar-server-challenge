<?php
/* server.hphp — the twelve-dollar feed API, written in HolyPHP.
 *
 * Everything the challenge measures lives in this file:
 *
 *   - the HTTP/1.1 keep-alive loop on top of the runtime's non-blocking
 *     socket primitives (stream_ready / stream_recv / stream_send),
 *   - request parsing and routing,
 *   - HS256 JWT verification (hash_hmac + hash_equals, on every request),
 *   - strict JSON request validation (the runtime's json_decode is lenient,
 *     so POST bodies go through the small parser below),
 *   - all SQL, including the SQLite JSON1 calls that render the response
 *     bodies inside the query,
 *   - the write policy: writes are collected during one poll cycle, applied
 *     in a single BEGIN IMMEDIATE … COMMIT (group commit), and only then is
 *     a 2xx sent.
 *
 * The native side is deliberately generic: sockets, HMAC, and a plain
 * SQLite binding. There is no challenge-specific C code.
 *
 * Config comes from the four SPEC.md variables:
 *   SQLITE_PATH, JWT_SECRET, HOST, PORT
 */

/* Strict RFC 8259 parser, used for POST /posts bodies. */
class Json {
    pub string $s;
    pub int $n;
    pub int $i;
    pub bool $ok;
    pub int $depth;
    pub $root = null;

    public function __construct(string $s) {
        $this->s = $s;
        $this->n = strlen($s);
        $this->i = 0;
        $this->ok = true;
        $this->depth = 0;
    }

    public function parse(): bool {
        $this->root = $this->value();
        if (!$this->ok) { return false; }
        $this->ws();
        return $this->i == $this->n;
    }

    public function ws(): void {
        while ($this->i < $this->n) {
            $c = $this->s[$this->i];
            if ($c == " " || $c == "\t" || $c == "\n" || $c == "\r") {
                $this->i = $this->i + 1;
            } else {
                return;
            }
        }
    }

    public function value() {
        $this->ws();
        if ($this->i >= $this->n) { $this->ok = false; return null; }
        $c = $this->s[$this->i];
        if ($c == "{") { return $this->object(); }
        if ($c == "[") { return $this->arr(); }
        if ($c == "\"") { return $this->str(); }
        if ($c == "t") { if ($this->lit("true")) { return true; } $this->ok = false; return null; }
        if ($c == "f") { if ($this->lit("false")) { return false; } $this->ok = false; return null; }
        if ($c == "n") { if ($this->lit("null")) { return null; } $this->ok = false; return null; }
        if ($c == "-" || ($c >= "0" && $c <= "9")) { return $this->num(); }
        $this->ok = false;
        return null;
    }

    public function lit(string $w): bool {
        $l = strlen($w);
        if ($this->i + $l > $this->n) { return false; }
        if (substr($this->s, $this->i, $l) != $w) { return false; }
        $this->i = $this->i + $l;
        return true;
    }

    public function object() {
        $this->depth = $this->depth + 1;
        if ($this->depth > 64) { $this->ok = false; return []; }
        $this->i = $this->i + 1;
        $out = [];
        $this->ws();
        if ($this->i < $this->n && $this->s[$this->i] == "}") {
            $this->i = $this->i + 1;
            $this->depth = $this->depth - 1;
            return $out;
        }
        while (true) {
            $this->ws();
            if ($this->i >= $this->n || $this->s[$this->i] != "\"") { $this->ok = false; return $out; }
            $k = $this->str();
            if (!$this->ok) { return $out; }
            $this->ws();
            if ($this->i >= $this->n || $this->s[$this->i] != ":") { $this->ok = false; return $out; }
            $this->i = $this->i + 1;
            $v = $this->value();
            if (!$this->ok) { return $out; }
            $out[$k] = $v;
            $this->ws();
            if ($this->i >= $this->n) { $this->ok = false; return $out; }
            $c = $this->s[$this->i];
            if ($c == ",") { $this->i = $this->i + 1; continue; }
            if ($c == "}") {
                $this->i = $this->i + 1;
                $this->depth = $this->depth - 1;
                return $out;
            }
            $this->ok = false;
            return $out;
        }
    }

    public function arr() {
        $this->depth = $this->depth + 1;
        if ($this->depth > 64) { $this->ok = false; return []; }
        $this->i = $this->i + 1;
        $out = [];
        $this->ws();
        if ($this->i < $this->n && $this->s[$this->i] == "]") {
            $this->i = $this->i + 1;
            $this->depth = $this->depth - 1;
            return $out;
        }
        while (true) {
            $v = $this->value();
            if (!$this->ok) { return $out; }
            $out[] = $v;
            $this->ws();
            if ($this->i >= $this->n) { $this->ok = false; return $out; }
            $c = $this->s[$this->i];
            if ($c == ",") { $this->i = $this->i + 1; continue; }
            if ($c == "]") {
                $this->i = $this->i + 1;
                $this->depth = $this->depth - 1;
                return $out;
            }
            $this->ok = false;
            return $out;
        }
    }

    public function str() {
        if ($this->i >= $this->n || $this->s[$this->i] != "\"") { $this->ok = false; return ""; }
        $this->i = $this->i + 1;
        $out = "";
        while ($this->i < $this->n) {
            $c = $this->s[$this->i];
            $this->i = $this->i + 1;
            if ($c == "\"") { return $out; }
            if ($c == chr(92)) {
                if ($this->i >= $this->n) { $this->ok = false; return ""; }
                $e = $this->s[$this->i];
                $this->i = $this->i + 1;
                if ($e == "\"") { $out .= "\""; }
                else if ($e == chr(92)) { $out .= chr(92); }
                else if ($e == "/") { $out .= "/"; }
                else if ($e == "b") { $out .= chr(8); }
                else if ($e == "f") { $out .= chr(12); }
                else if ($e == "n") { $out .= "\n"; }
                else if ($e == "r") { $out .= "\r"; }
                else if ($e == "t") { $out .= "\t"; }
                else if ($e == "u") {
                    $cp = $this->hex4();
                    if (!$this->ok) { return ""; }
                    if ($cp >= 55296 && $cp <= 56319) {
                        if ($this->i + 1 < $this->n
                            && $this->s[$this->i] == chr(92) && $this->s[$this->i + 1] == "u") {
                            $this->i = $this->i + 2;
                            $lo = $this->hex4();
                            if (!$this->ok || $lo < 56320 || $lo > 57343) { $this->ok = false; return ""; }
                            $cp = 65536 + (($cp - 55296) << 10) + ($lo - 56320);
                        } else {
                            $this->ok = false;
                            return "";
                        }
                    } else if ($cp >= 56320 && $cp <= 57343) {
                        $this->ok = false;
                        return "";
                    }
                    $out .= $this->utf8($cp);
                } else {
                    $this->ok = false;
                    return "";
                }
            } else if (ord($c) < 32) {
                $this->ok = false;
                return "";
            } else {
                $out .= $c;
            }
        }
        $this->ok = false;
        return "";
    }

    public function hex4(): int {
        if ($this->i + 4 > $this->n) { $this->ok = false; return 0; }
        $v = 0;
        for ($k = 0; $k < 4; $k++) {
            $c = $this->s[$this->i + $k];
            $d = -1;
            if ($c >= "0" && $c <= "9") { $d = ord($c) - 48; }
            else if ($c >= "a" && $c <= "f") { $d = ord($c) - 87; }
            else if ($c >= "A" && $c <= "F") { $d = ord($c) - 55; }
            if ($d < 0) { $this->ok = false; return 0; }
            $v = $v * 16 + $d;
        }
        $this->i = $this->i + 4;
        return $v;
    }

    public function utf8(int $cp): string {
        if ($cp < 128) { return chr($cp); }
        if ($cp < 2048) {
            return chr(192 + ($cp >> 6)) . chr(128 + ($cp & 63));
        }
        if ($cp < 65536) {
            return chr(224 + ($cp >> 12)) . chr(128 + (($cp >> 6) & 63)) . chr(128 + ($cp & 63));
        }
        return chr(240 + ($cp >> 18)) . chr(128 + (($cp >> 12) & 63))
             . chr(128 + (($cp >> 6) & 63)) . chr(128 + ($cp & 63));
    }

    public function num() {
        if ($this->i < $this->n && $this->s[$this->i] == "-") { $this->i = $this->i + 1; }
        if ($this->i >= $this->n) { $this->ok = false; return 0; }
        $c = $this->s[$this->i];
        if ($c == "0") {
            $this->i = $this->i + 1;
        } else if ($c >= "1" && $c <= "9") {
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; } else { break; }
            }
        } else {
            $this->ok = false;
            return 0;
        }
        if ($this->i < $this->n && $this->s[$this->i] == ".") {
            $this->i = $this->i + 1;
            $d = 0;
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; $d = $d + 1; } else { break; }
            }
            if ($d == 0) { $this->ok = false; return 0; }
        }
        if ($this->i < $this->n && ($this->s[$this->i] == "e" || $this->s[$this->i] == "E")) {
            $this->i = $this->i + 1;
            if ($this->i < $this->n && ($this->s[$this->i] == "+" || $this->s[$this->i] == "-")) {
                $this->i = $this->i + 1;
            }
            $d = 0;
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; $d = $d + 1; } else { break; }
            }
            if ($d == 0) { $this->ok = false; return 0; }
        }
        return 0;
    }
}

/* --------------------------------------------------------------- server */

class Server {
    pub int $srv = 0;
    pub int $db = 0;
    pub string $secret = "";
    pub int $start = 0;
    pub int $sweep = 0;

    /* per-connection state, keyed by socket fd */
    pub array $socks = [];
    pub array $bufs = [];
    pub array $lasts = [];

    /* deferred writes for the current poll cycle */
    pub array $pending = [];

    /* ready list, kept between rounds so a round allocates no array */
    pub array $ready = [];

    /* response header prefixes per status code, built once */
    pub array $hdr = [];

    pub int $feed = 0;
    pub int $post = 0;
    pub int $health = 0;
    pub int $insPost = 0;
    pub int $insLike = 0;
    pub int $hasPost = 0;

    /* ------------------------------------------------------- setup */

    public function open(string $host, int $port): bool {
        $path = getenv("SQLITE_PATH");
        if ($path === false || $path == "") { $path = "feed.db"; }
        $sec = getenv("JWT_SECRET");
        if ($sec === false || $sec == "") { $sec = "twelve-dollar-challenge"; }
        $this->secret = $sec;

        $db = sqlite_open($path);
        if ($db == 0) {
            echo "fatal: cannot open sqlite database " . $path . "\n";
            return false;
        }
        $this->db = $db;
        sqlite_busy_timeout($db, 5000);
        sqlite_exec($db, "PRAGMA journal_mode=WAL");
        sqlite_exec($db, "PRAGMA synchronous=NORMAL");
        sqlite_exec($db, "PRAGMA temp_store=MEMORY");
        sqlite_exec($db, "PRAGMA cache_size=-65536");
        sqlite_exec($db, "PRAGMA mmap_size=268435456");
        sqlite_exec($db, "PRAGMA foreign_keys=OFF");

        /* The response bodies are rendered by SQLite's JSON1 functions, in
         * the exact key order the spec wants. The feed's ordering comes from
         * the input subquery; json_group_array appends rows in that order, so
         * no second sort inside the aggregate is needed.
         * (INSERT ... RETURNING needs SQLite >= 3.35; Ubuntu 24.04 has 3.45.) */
        $q = "SELECT '{' || '\"posts\":' || json_group_array(json_object("
           . "'id', p.id, 'body', p.body, 'created_at', p.created_at, "
           . "'author', p.author, "
           . "'like_count', (SELECT count(*) FROM likes l WHERE l.post_id = p.id)"
           . ") ) || '}' "
           . "FROM (SELECT p.id, p.body, p.created_at, u.username AS author "
           . "FROM posts p JOIN users u ON u.id = p.user_id "
           /* ids are assigned in insert order and created_at is set from the
            * clock at the same moment, so id DESC is the same order as
            * created_at DESC, id DESC (verified byte-identical against
            * test/golden/feed.json) and it walks the rowid index instead of
            * a second index plus scattered row lookups. */
           . "ORDER BY p.id DESC LIMIT 20) p";
        $this->feed = sqlite_prepare($db, $q);
        if ($this->feed == 0) {
            echo "fatal: feed query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "SELECT json_object('post', json_object("
           . "'id', p.id, 'body', p.body, 'created_at', p.created_at, "
           . "'author', (SELECT username FROM users u WHERE u.id = p.user_id), "
           . "'like_count', (SELECT count(*) FROM likes l WHERE l.post_id = p.id)"
           . ")) FROM posts p WHERE p.id = ?1";
        $this->post = sqlite_prepare($db, $q);
        if ($this->post == 0) {
            echo "fatal: post query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $this->health = sqlite_prepare($db, "SELECT 1");
        if ($this->health == 0) {
            echo "fatal: health query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "INSERT INTO posts (user_id, body) VALUES (?1, ?2) "
           . "RETURNING json_object('post', json_object("
           . "'id', id, 'body', body, 'created_at', created_at, "
           . "'author', ?3, 'like_count', 0))";
        $this->insPost = sqlite_prepare($db, $q);
        if ($this->insPost == 0) {
            echo "fatal: insert post: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "INSERT INTO likes (user_id, post_id) VALUES (?1, ?2) "
           . "ON CONFLICT (user_id, post_id) DO NOTHING";
        $this->insLike = sqlite_prepare($db, $q);
        if ($this->insLike == 0) {
            echo "fatal: insert like: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $this->hasPost = sqlite_prepare($db, "SELECT 1 FROM posts WHERE id = ?1 LIMIT 1");
        if ($this->hasPost == 0) {
            echo "fatal: post exists query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $addr = "tcp://" . $host . ":" . $port;
        $srv = stream_socket_server($addr);
        if ($srv === false || intval($srv) <= 0) {
            /* Direct mode failed (typically because Nginx already owns :80).
             * Fall back to the Nginx upstream address instead of dying, so
             * the service always comes up. */
            $addr = "tcp://127.0.0.1:3000";
            $srv = stream_socket_server($addr);
            if ($srv === false || intval($srv) <= 0) {
                echo "fatal: cannot listen on " . $host . ":" . $port . " or 127.0.0.1:3000\n";
                return false;
            }
        }
        $this->srv = intval($srv);
        epoll_add($this->srv);

        $codes = [200, 201, 400, 401, 404, 500, 503];
        $texts = ["OK", "Created", "Bad Request", "Unauthorized",
                  "Not Found", "Internal Server Error", "Service Unavailable"];
        for ($i = 0; $i < 7; $i++) {
            $this->hdr[$codes[$i]] = "HTTP/1.1 " . $codes[$i] . " " . $texts[$i]
                . "\r\nContent-Type: application/json\r\nContent-Encoding: identity"
                . "\r\nContent-Length: ";
        }
        $this->start = time();
        $this->sweep = $this->start;
        return true;
    }

    /* -------------------------------------------------------- main loop */

    public function run(): void {
        while (true) {
            /* Everything allocated while serving this poll cycle is released
             * by scope_end(): no per-request malloc survives the round. */
            scope_begin();

            epoll_wait_into($this->ready, 50);
            foreach ($this->ready as $h) {
                $fd = intval($h);
                if ($fd == $this->srv) {
                    $this->accept_all();
                } else {
                    /* Every fd in the epoll set came from accept(), so it is
                     * ours even if the bookkeeping array lost the entry.
                     * read_fd() closes it on EOF, which also drops the epoll
                     * registration — never skip a ready fd, or the loop
                     * spins on it forever. */
                    $this->read_fd($fd);
                }
            }
            $this->execute_writes();

            $now = time();
            if ($now != $this->sweep) {
                $this->sweep = $now;
                $this->expire($now);
            }

            scope_end();
        }
    }

    public function accept_all(): void {
        while (true) {
            $s = stream_socket_accept2($this->srv, 0);
            if ($s === false) { return; }
            $fd = intval($s);
            if ($fd <= 0) { return; }
            stream_set_nodelay($fd);
            $this->socks[$fd] = $fd;
            $this->bufs[$fd] = "";
            $this->lasts[$fd] = time();
            epoll_add($fd);
        }
    }

    /* Nginx keeps idle upstream connections for up to 60 s and the spec asks
     * us to hold them for at least 65 s, so only drop after 90 s of silence. */
    public function expire(int $now): void {
        $dead = [];
        foreach ($this->socks as $fd) {
            if ($now - $this->lasts[$fd] >= 90) { $dead[] = $fd; }
        }
        foreach ($dead as $fd) {
            $this->close_fd($fd);
        }
        arr_free($dead);
    }

    public function close_fd(int $fd): void {
        unset($this->socks[$fd]);
        unset($this->bufs[$fd]);
        unset($this->lasts[$fd]);
        epoll_del($fd);
        stream_close($fd);
    }

    /* -------------------------------------------------------- read side */

    public function read_fd(int $fd): void {
        $chunk = stream_recv($fd, 4096);
        if ($chunk == "") {
            if (stream_eof($fd)) { $this->close_fd($fd); }
            return;
        }
        /* $this->bufs[$fd] is "" (static) or a heap copy of a partial
         * request; the concatenation lives in the request scope and is
         * either consumed here or copied back with str_persist(). */
        $this->lasts[$fd] = time();
        $old = $this->bufs[$fd];
        if ($old == "") {
            /* the common case: a whole request in one recv, no copy at all */
            $this->parse($fd, $chunk);
        } else {
            $buf = $old . $chunk;
            str_free($old);
            $this->bufs[$fd] = "";
            $this->parse($fd, $buf);
        }
    }

    public function parse(int $fd, string $in): void {
        $buf = $in;
        while (true) {
            $he = strpos($buf, "\r\n\r\n");
            if ($he === false) {
                if (strlen($buf) > 131072) {
                    $this->close_fd($fd);
                    return;
                }
                if (strlen($buf) == 0) {
                    $this->bufs[$fd] = "";
                } else {
                    $this->bufs[$fd] = str_persist($buf);
                }
                return;
            }
            $head = substr($buf, 0, $he);
            $le = strpos($head, "\r\n");
            if ($le === false) { $le = strlen($head); }
            $line = substr($head, 0, $le);
            $sp1 = strpos($line, " ");
            if ($sp1 === false) { $this->close_fd($fd); return; }
            $sp2 = strpos($line, " ", $sp1 + 1);
            if ($sp2 === false) { $this->close_fd($fd); return; }
            $method = substr($line, 0, $sp1);
            $path = substr($line, $sp1 + 1, $sp2 - $sp1 - 1);

            $cl = 0;
            $auth = "";
            if ($method != "GET") {
                $lc = strtolower($head);
                $k = strpos($lc, "\r\ncontent-length:");
                if ($k !== false) {
                    $e = strpos($lc, "\r\n", $k + 2);
                    if ($e === false) { $e = strlen($head); }
                    $cl = intval(substr($head, $k + 17, $e - ($k + 17)));
                }
                $ak = strpos($lc, "\r\nauthorization:");
                if ($ak !== false) {
                    $ae = strpos($lc, "\r\n", $ak + 2);
                    if ($ae === false) { $ae = strlen($head); }
                    $auth = trim(substr($head, $ak + 16, $ae - ($ak + 16)));
                }
            }
            if ($cl < 0 || $cl > 1048576) {
                $this->close_fd($fd);
                return;
            }

            $start = $he + 4;
            if (strlen($buf) - $start < $cl) {
                $this->bufs[$fd] = str_persist($buf);
                return;
            }
            $body = "";
            if ($cl > 0) { $body = substr($buf, $start, $cl); }
            $buf = substr($buf, $start + $cl);

            $this->dispatch($fd, $method, $path, $auth, $body);
            if (!isset($this->socks[$fd])) { return; }
        }
    }

    /* --------------------------------------------------------- routing */

    public function dispatch(int $fd, string $method, string $path, string $auth, string $body): void {
        if ($path == "/health") { $this->on_health($fd); return; }
        if ($path == "/feed") { $this->on_feed($fd); return; }
        if ($path == "/posts") {
            if ($method == "POST") { $this->on_create($fd, $auth, $body); return; }
            $this->send_json($fd, 404, '{"error":"not found"}');
            return;
        }
        if (str_starts_with($path, "/posts/")) {
            $rest = substr($path, 7);
            $n = strlen($rest);
            if ($n > 5 && str_ends_with($rest, "/like")) {
                if ($method == "POST") {
                    $this->on_like($fd, $auth, substr($rest, 0, $n - 5));
                    return;
                }
            }
            $this->on_post($fd, $rest);
            return;
        }
        $this->send_json($fd, 404, '{"error":"not found"}');
    }

    public function on_feed(int $fd): void {
        $rc = sqlite_step($this->feed);
        if ($rc == 100) {
            $b = sqlite_column_text($this->feed, 0);
        } else {
            $b = '{"posts":[]}';
        }
        sqlite_reset($this->feed);
        $this->send_json($fd, 200, $b);
    }

    public function on_post(int $fd, string $ids): void {
        $id = $this->parse_id($ids);
        if ($id <= 0) {
            $this->send_json($fd, 400, '{"error":"invalid post id"}');
            return;
        }
        sqlite_bind_int($this->post, 1, $id);
        $rc = sqlite_step($this->post);
        if ($rc == 100) {
            $b = sqlite_column_text($this->post, 0);
            sqlite_reset($this->post);
            sqlite_clear_bindings($this->post);
            $this->send_json($fd, 200, $b);
        } else {
            sqlite_reset($this->post);
            sqlite_clear_bindings($this->post);
            $this->send_json($fd, 404, '{"error":"post not found"}');
        }
    }

    public function on_health(int $fd): void {
        $rc = sqlite_step($this->health);
        if ($rc == 100) {
            sqlite_reset($this->health);
            $b = '{"status":"ok","db":"ok","uptime_s":' . (time() - $this->start) . '}';
            $this->send_json($fd, 200, $b);
        } else {
            $e = sqlite_errmsg($this->db);
            sqlite_reset($this->health);
            $b = '{"status":"degraded","db":"unreachable","error":' . json_encode($e) . '}';
            $this->send_json($fd, 503, $b);
        }
    }

    public function on_create(int $fd, string $auth, string $body): void {
        $a = $this->authenticate($auth);
        if ($a[0] == 1) { arr_free($a); $this->send_json($fd, 401, '{"error":"missing bearer token"}'); return; }
        if ($a[0] == 2) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid or expired token"}'); return; }
        if ($a[0] == 3) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid token payload"}'); return; }
        $uid = $a[1];
        $uname = $a[2];
        arr_free($a);

        $j = new Json($body);
        if (!$j->parse()) {
            $this->send_json($fd, 400, '{"error":"malformed JSON body"}');
            return;
        }
        $v = $j->root;
        if (!is_array($v) || !isset($v["body"]) || !is_string($v["body"])) {
            arr_free($v);
            $this->send_json($fd, 400, '{"error":"body is required"}');
            return;
        }
        $text = trim($v["body"]);
        arr_free($v);
        if ($text == "") {
            $this->send_json($fd, 400, '{"error":"body is required"}');
            return;
        }
        if ($this->cp_len($text) > 500) {
            $this->send_json($fd, 400, '{"error":"body must be at most 500 characters"}');
            return;
        }
        $r = [];
        $r["kind"] = 1;
        $r["fd"] = $fd;
        $r["code"] = 0;
        $r["body"] = "";
        $r["uid"] = $uid;
        $r["pid"] = 0;
        $r["text"] = $text;
        $r["name"] = $uname;
        $this->pending[] = $r;
    }

    public function on_like(int $fd, string $auth, string $ids): void {
        $a = $this->authenticate($auth);
        if ($a[0] == 1) { arr_free($a); $this->send_json($fd, 401, '{"error":"missing bearer token"}'); return; }
        if ($a[0] == 2) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid or expired token"}'); return; }
        if ($a[0] == 3) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid token payload"}'); return; }
        $uid = $a[1];
        arr_free($a);

        $id = $this->parse_id($ids);
        if ($id <= 0) {
            $this->send_json($fd, 400, '{"error":"invalid post id"}');
            return;
        }
        $r = [];
        $r["kind"] = 2;
        $r["fd"] = $fd;
        $r["code"] = 0;
        $r["body"] = "";
        $r["uid"] = $uid;
        $r["pid"] = $id;
        $r["text"] = "";
        $r["name"] = "";
        $this->pending[] = $r;
    }

    /* --------------------------------------------------------- auth */

    /* returns [0, uid, username] | [1] missing | [2] bad token | [3] bad payload */
    public function authenticate(string $hdr) {
        if ($hdr == "" || strlen($hdr) < 7) { return [1]; }
        if (strtolower(substr($hdr, 0, 7)) != "bearer ") { return [1]; }
        $tok = trim(substr($hdr, 7));
        if ($tok == "") { return [1]; }

        /* split into header.payload.signature without building an array */
        $p1 = strpos($tok, ".");
        if ($p1 === false) { return [2]; }
        $p2 = strpos($tok, ".", $p1 + 1);
        if ($p2 === false) { return [2]; }
        if (strpos($tok, ".", $p2 + 1) !== false) { return [2]; }

        $h64 = substr($tok, 0, $p1);
        $p64 = substr($tok, $p1 + 1, $p2 - $p1 - 1);
        $s64 = substr($tok, $p2 + 1);

        /* the header is a flat object: read "alg" directly instead of
         * decoding it into an array */
        if ($this->json_str($this->b64url($h64), "alg") != "HS256") { return [2]; }

        $sig = $this->b64url($s64);
        $mac = hash_hmac("sha256", $h64 . "." . $p64, $this->secret, true);
        if (!hash_equals($mac, $sig)) { return [2]; }

        /* same for the payload */
        $pj = $this->b64url($p64);
        $exp = $this->json_num($pj, "exp");
        if ($exp < 0) { return [2]; }
        if ($exp < time()) { return [2]; }

        $sub = $this->json_str($pj, "sub");
        if ($sub == "") { return [3]; }
        $uid = $this->parse_id($sub);
        if ($uid <= 0) { return [3]; }

        $name = $this->json_str($pj, "username");
        if ($name == "") { return [3]; }
        return [0, $uid, $name];
    }

    /* string value of "key" in a flat JSON object, "" when absent or not a
     * string. Saves decoding a whole object into an array per request. */
    public function json_str(string $j, string $key): string {
        $n = strlen($j);
        $k = "\"" . $key . "\"";
        $p = strpos($j, $k);
        if ($p === false) { return ""; }
        $i = intval($p) + strlen($k);
        while ($i < $n && $j[$i] != ":") {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { return ""; }
            $i++;
        }
        if ($i >= $n) { return ""; }
        $i++;
        while ($i < $n && $j[$i] != "\"") {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { return ""; }
            $i++;
        }
        if ($i >= $n) { return ""; }
        $i++;
        $out = "";
        while ($i < $n) {
            $c = $j[$i];
            if ($c == "\"") { return $out; }
            if ($c == chr(92)) {
                $i++;
                if ($i >= $n) { return ""; }
                $out .= $j[$i];
            } else {
                $out .= $c;
            }
            $i++;
        }
        return "";
    }

    /* integer value of "key", -1 when absent or not a number */
    public function json_num(string $j, string $key) {
        $n = strlen($j);
        $k = "\"" . $key . "\"";
        $p = strpos($j, $k);
        if ($p === false) { return -1; }
        $i = intval($p) + strlen($k);
        while ($i < $n && $j[$i] != ":") {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { return -1; }
            $i++;
        }
        if ($i >= $n) { return -1; }
        $i++;
        while ($i < $n) {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { break; }
            $i++;
        }
        $neg = false;
        if ($i < $n && $j[$i] == "-") { $neg = true; $i++; }
        $v = 0;
        $digits = 0;
        while ($i < $n) {
            $c = $j[$i];
            if ($c < "0" || $c > "9") { break; }
            $v = $v * 10 + (ord($c) - 48);
            $digits++;
            $i++;
        }
        if ($digits == 0) { return -1; }
        return $neg ? -$v : $v;
    }

    public function b64url(string $s): string {
        /* two whole-string replacements instead of rebuilding the token one
         * character at a time */
        $t = str_replace("-", "+", $s);
        $t = str_replace("_", "/", $t);
        $r = strlen($t) % 4;
        if ($r == 2) { $t .= "=="; }
        else if ($r == 3) { $t .= "="; }
        return base64_decode($t);
    }

    public function parse_id($s) {
        if (!is_string($s)) { return -1; }
        $n = strlen($s);
        if ($n < 1 || $n > 18) { return -1; }
        $v = 0;
        for ($i = 0; $i < $n; $i++) {
            $ch = $s[$i];
            if ($ch < "0" || $ch > "9") { return -1; }
            $v = $v * 10 + (ord($ch) - 48);
        }
        if ($v <= 0) { return -1; }
        return $v;
    }

    public function cp_len(string $s): int {
        $n = strlen($s);
        $c = 0;
        for ($i = 0; $i < $n; $i++) {
            if ((ord($s[$i]) & 192) != 128) { $c = $c + 1; }
        }
        return $c;
    }

    /* -------------------------------------------------- write + commit */

    public function execute_writes(): void {
        $n = count($this->pending);
        if ($n == 0) { return; }

        if (!sqlite_exec($this->db, "BEGIN IMMEDIATE")) {
            $this->fail_writes();
            $this->flush();
            return;
        }

        $ok = true;
        $i = 0;
        while ($i < $n) {
            $r = $this->pending[$i];
            if ($r["kind"] == 1) {
                sqlite_bind_int($this->insPost, 1, $r["uid"]);
                sqlite_bind_text($this->insPost, 2, $r["text"]);
                sqlite_bind_text($this->insPost, 3, $r["name"]);
                $rc = sqlite_step($this->insPost);
                if ($rc != 100) { $ok = false; break; }
                $r["body"] = sqlite_column_text($this->insPost, 0);
                $r["code"] = 201;
                sqlite_step($this->insPost);
                sqlite_reset($this->insPost);
                sqlite_clear_bindings($this->insPost);
                $this->pending[$i] = $r;
            } else if ($r["kind"] == 2) {
                sqlite_bind_int($this->hasPost, 1, $r["pid"]);
                $hc = sqlite_step($this->hasPost);
                sqlite_reset($this->hasPost);
                sqlite_clear_bindings($this->hasPost);
                if ($hc != 100) {
                    $r["code"] = 404;
                    $r["body"] = '{"error":"post not found"}';
                    $this->pending[$i] = $r;
                    $i = $i + 1;
                    continue;
                }
                sqlite_bind_int($this->insLike, 1, $r["uid"]);
                sqlite_bind_int($this->insLike, 2, $r["pid"]);
                $rc = sqlite_step($this->insLike);
                $ch = sqlite_changes($this->db);
                sqlite_reset($this->insLike);
                sqlite_clear_bindings($this->insLike);
                if ($rc != 101 && $rc != 100) { $ok = false; break; }
                if ($ch > 0) {
                    $r["code"] = 201;
                    $r["body"] = '{"liked":true,"already_liked":false,"post_id":' . $r["pid"] . '}';
                } else {
                    $r["code"] = 200;
                    $r["body"] = '{"liked":true,"already_liked":true,"post_id":' . $r["pid"] . '}';
                }
                $this->pending[$i] = $r;
            }
            $i = $i + 1;
        }

        if ($ok && !sqlite_exec($this->db, "COMMIT")) { $ok = false; }
        if (!$ok) {
            sqlite_exec($this->db, "ROLLBACK");
            $this->fail_writes();
        }
        $this->flush();
    }

    public function fail_writes(): void {
        $i = 0;
        $n = count($this->pending);
        while ($i < $n) {
            $r = $this->pending[$i];
            $r["code"] = 500;
            $r["body"] = '{"error":"internal server error"}';
            $this->pending[$i] = $r;
            $i = $i + 1;
        }
    }

    public function flush(): void {
        foreach ($this->pending as $r) {
            $this->write_response($r["fd"], $r["code"], $r["body"]);
            arr_free($r);
        }
        arr_clear($this->pending);
    }

    /* ------------------------------------------------------ send side */

    public function send_json(int $fd, int $code, string $body): void {
        $this->write_response($fd, $code, $body);
    }

    public function write_response(int $fd, int $code, string $body): void {
        /* Direct mode holds one fd per user. Keep a reserve below the box's
         * 65535 LimitNOFILE: above the threshold the response asks the client
         * to reconnect, so new users are never refused. */
        $shed = count($this->socks) >= 58000;
        $blen = strlen($body);
        /* The status line and the fixed headers are prebuilt per code, so a
         * response costs three concatenations instead of ten. */
        $h = $this->hdr[$code] . $blen . ($shed
            ? "\r\nConnection: close\r\n\r\n"
            : "\r\nConnection: keep-alive\r\n\r\n");
        if ($blen < 1024) {
            /* small body: one write, no big copy */
            $out = $h . $body;
            $sent = stream_send($fd, $out);
            if ($sent != strlen($out) || $shed) { $this->close_fd($fd); }
            return;
        }
        /* big body (/feed): write header and body separately so the 5 KB
         * payload is not copied through one more string */
        $sent = stream_send($fd, $h);
        if ($sent != strlen($h)) { $this->close_fd($fd); return; }
        $sent2 = stream_send($fd, $body);
        if ($sent2 != $blen || $shed) { $this->close_fd($fd); }
    }
}

/* ---------------------------------------------------------------- main */

$port = 3000;
$p = getenv("PORT");
if ($p !== false && $p != "") { $port = intval($p); }

$host = "0.0.0.0";
$h = getenv("HOST");
if ($h !== false && $h != "") { $host = $h; }

$server = new Server();
if (!$server->open($host, $port)) { exit(1); }
$server->run();
